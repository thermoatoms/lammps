# split_cache path test: sub-style 1 is "Au Au" (type-invariant), sub-style 2 is "Au Cu"
# At lambda=1 (flambda=1, blambda=0): only the "Au Au" sub-style contributes.
# At lambda=0 (flambda=0, blambda=1): only the "Au Cu" sub-style contributes.
#
# Usage:
#   lmp -var lambda 1.0 -in lmp_splitcache.in          # endpoint 1: pure Au-Au potential
#   lmp -var lambda 0.0 -in lmp_splitcache.in          # endpoint 0: pure Au-Cu potential
#   lmp -var lambda 0.5 -in lmp_splitcache.in          # mid-point: activates split_cache

units           metal
atom_style      atomic
boundary        p p p

lattice         fcc 4.08
region          box block 0 5 0 5 0 5
create_box      2 box
create_atoms    1 box

set             type 1 type/fraction 2 0.5 12345

mass            1 196.97
mass            2 63.55

variable        flambda equal v_lambda
variable        blambda equal 1.0-v_lambda

pair_style      hybrid/scaled v_flambda pace v_blambda pace
pair_coeff      * * pace 1 AuCu_LDA.yace Au Au
pair_coeff      * * pace 2 AuCu_LDA.yace Au Cu

velocity        all create 800.0 42 mom yes rot yes dist gaussian
fix             nvt all nvt temp 800 800 0.1

fix             swap all atom/swap 1 10 12 800 ke no types 1 2 localE yes

thermo          10
thermo_style    custom step pe temp

run             100
