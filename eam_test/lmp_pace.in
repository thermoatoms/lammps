units           metal
atom_style      atomic
boundary        p p p

lattice         fcc 4.08
region          box block 0 5 0 5 0 5
create_box      2 box
create_atoms    1 box

# 50/50 mixture: make every other atom type 2
set             type 1 type/fraction 2 0.5 12345

mass            1 196.97
mass            2 63.55

pair_style      pace
pair_coeff      * * AuCu_LDA.yace Au Cu

velocity        all create 800.0 42 mom yes rot yes dist gaussian
fix             nvt all nvt temp 800 800 0.1

# fix swap: localE flag toggled per run
fix             swap all atom/swap 1 10 12 800 ke no types 1 2 SWAP_KEYWORD

thermo          10
thermo_style    custom step pe temp

run             100
